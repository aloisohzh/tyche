# Python
__pycache__/
*.py[cod]
.venv/
.venv-lean/
*.egg-info/
.pytest_cache/
.ruff_cache/
build/
dist/

# Runtime artifacts (root-anchored so sanitized copies nested under
# docs/performance/<date>/{reports,plans,journal,data} are NOT shadowed)
/data/*.csv
/data/*.json
# Operator input, not runtime artifacts: the pre-approved order envelope, the shared kill-switch flag
# and the strategy switches must reach the cloud mount via git (cloud push-back is 403).
!/data/approvals.json
!/data/approvals.example.json
!/data/halt.json
!/data/strategies.json
!/data/scalp-approvals.json
# The kernel's drafted exit note (proposed bounds, never an approval). Covered by /data/*.json
# today, stated explicitly because a draft must not reach the cloud mount even if that changes:
# only Arm writes data/approvals.json.
/data/approvals.proposed.json
/journal/
/plans/
/reports/
# Run scratch: raw fetches, snapshots and receipts. The performance reports cite
# these by path + sha256, so they are evidence - but they are only preserved when
# `tyche persist` is run against them (ADR 0009), and never committed.
/runs/
/data/research/
# The NYSE page a calendar-drift check saves is re-fetchable scratch, not evidence: the check's report
# is the artifact, the dump is not.
/data/nyse-calendar.txt
# Transient broker feeds carry the paper account id in raw payloads; never tracked.
/data/feed-*/
/data/work-*/
/data/capture-*/
/data/drill/
/research/lean/data/
/research/lean/PB001/backtests/
/research/youtube/raw/
.env
.telegram-bridge.json
# wait-for-reply state, written next to a run-local proposal file
*.wait.json
*.qoder.site
.cloud-release/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
# Per-machine Claude Code permission rules (the laptop's one-folder allow rule for plans/managed-migration/*)
.claude/settings.local.json

# Copy to .env and fill locally. Never commit .env.
# Qoder Cloud Agents PAT (server-side only: Forward API and channel pairing).
QODER_PAT=
# Paper account ids allowed by the guard (comma-separated).
TYCHE_ALLOWED_ACCOUNT_IDS=
# Telegram sentinel bot (server-side only; copied into the cloud vault).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
# Forward webhook signing.
FORWARD_SIGNING_SECRET=
FORWARD_WEBHOOK_ENDPOINT_ID=
